# ============================================================
#  .env de PRODUCCIÓN · gestionrrhh.migestion.com.ar
#  Copiar en el VPS como /var/www/gestionrrhh/.env
#  (nunca subir este archivo con datos reales a GitHub)
# ============================================================
APP_NAME="Gestión RRHH"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gestionrrhh.migestion.com.ar
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestionrrhh
DB_USERNAME=gestionrrhh
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=gestionrrhh.migestion.com.ar
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Correo (opcional, para más adelante)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@migestion.com.ar"
MAIL_FROM_NAME="${APP_NAME}"

# Superadmin inicial (lo usa ProduccionSeeder; borrar la clave después del primer ingreso)
ADMIN_EMAIL=admin@migestion.com.ar
ADMIN_PASSWORD=
